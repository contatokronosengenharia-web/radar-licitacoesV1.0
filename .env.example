# Banco (Neon). Use a URL com pooler na aplicação e a direta nas migrações.
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/radar?sslmode=require
DATABASE_URL_UNPOOLED=postgres://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/radar?sslmode=require

# Better Auth: segredo com 32+ caracteres (openssl rand -base64 32) e a URL pública do app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Protege as rotas /api/cron/*. A Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Opcionais (valores padrão entre parênteses)
# COLETA_DIAS_INICIAIS=1   COLETA_MAX_DIAS=7   COLETA_EXPIRA_HORAS=3
# FILA_ORCAMENTO_MS=240000 MOTOR_LOTE=500      DATABASE_POOL_MAX=5
